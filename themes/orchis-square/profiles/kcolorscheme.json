{
  "schema_version": 1,
  "id": "dinx.orchis-square.kcolorscheme",
  "application": "kcolorscheme",
  "adapter": "kcolorscheme",
  "name": "Orchis Square \u00b7 kcolorscheme",
  "author": "DINX",
  "license": "MIT",
  "source": "https://github.com/rufl/Orchis-theme",
  "asset_version": "1.0.0",
  "variants": [
    "dark",
    "light"
  ],
  "templates": [
    {
      "path": "profiles/kcolorscheme.colors",
      "output": "kcolorscheme.colors"
    },
    {
      "path": "profiles/dark-kcolorscheme.colors",
      "output": "dark-kcolorscheme.colors"
    },
    {
      "path": "profiles/light-kcolorscheme.colors",
      "output": "light-kcolorscheme.colors"
    }
  ],
  "instructions": "Applied to KDE Frameworks applications (Krita, KIO dialogs) while this theme is active."
}
