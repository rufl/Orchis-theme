{
  "schema_version": 2,
  "id": "dinx.orchis-square",
  "name": "Orchis Square",
  "author": "DINX",
  "license": "GPL-3.0-only",
  "source": "https://github.com/rufl/Orchis-theme",
  "asset_version": "1.2.0",
  "requires": {
    "palette_api": 1,
    "style_api": 1,
    "profile_api": 1
  },
  "palettes": {
    "dark": "dark.json",
    "light": "light.json"
  },
  "style": {
    "tokens": "tokens.json",
    "css": "components.css"
  },
  "profiles": [
    "profiles/gtk.json",
    "profiles/qt5ct.json",
    "profiles/qt6ct.json",
    "profiles/kcolorscheme.json",
    "profiles/ghostty.json"
  ],
  "defaults": [
    {
      "application": "gtk",
      "profile": "dinx.orchis-square.gtk"
    },
    {
      "application": "qt5ct",
      "profile": "dinx.orchis-square.qt5ct"
    },
    {
      "application": "qt6ct",
      "profile": "dinx.orchis-square.qt6ct"
    },
    {
      "application": "kcolorscheme",
      "profile": "dinx.orchis-square.kcolorscheme"
    },
    {
      "application": "ghostty",
      "profile": "dinx.orchis-square.ghostty"
    }
  ]
}
